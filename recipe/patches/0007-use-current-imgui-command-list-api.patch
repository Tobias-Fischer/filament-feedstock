From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jeongseok Lee <jeongseok@meta.com>
Date: Sun, 13 Sep 2026 07:30:00 -0700
Subject: [PATCH] Use current ImDrawData command-list API

Dear ImGui 1.92.9 no longer maintains the obsolete CmdListsCount field on
the docking branch. Read the ImVector size directly as recommended upstream.
---
 libs/filagui/src/ImGuiHelper.cpp | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/libs/filagui/src/ImGuiHelper.cpp b/libs/filagui/src/ImGuiHelper.cpp
--- a/libs/filagui/src/ImGuiHelper.cpp
+++ b/libs/filagui/src/ImGuiHelper.cpp
@@ -249,12 +249,12 @@ void ImGuiHelper::processImGuiCommands(ImDrawData* commands, const ImGuiIO& io)
     commands->ScaleClipRects(io.DisplayFramebufferScale);
 
     // Ensure that we have enough vertex buffers and index buffers.
-    createBuffers(commands->CmdListsCount);
+    createBuffers(commands->CmdLists.Size);
 
     // Count how many primitives we'll need, then create a Renderable builder.
     size_t nPrims = 0;
     std::unordered_map<uint64_t, filament::MaterialInstance*> scissorRects;
-    for (int cmdListIndex = 0; cmdListIndex < commands->CmdListsCount; cmdListIndex++) {
+    for (int cmdListIndex = 0; cmdListIndex < commands->CmdLists.Size; cmdListIndex++) {
         const ImDrawList* cmds = commands->CmdLists[cmdListIndex];
         nPrims += cmds->CmdBuffer.size();
     }
@@ -267,7 +267,7 @@ void ImGuiHelper::processImGuiCommands(ImDrawData* commands, const ImGuiIO& io)
     int primIndex = 0;
     int material2dIndex = 0;
     int materialExternalIndex = 0;
-    for (int cmdListIndex = 0; cmdListIndex < commands->CmdListsCount; cmdListIndex++) {
+    for (int cmdListIndex = 0; cmdListIndex < commands->CmdLists.Size; cmdListIndex++) {
         const ImDrawList* cmds = commands->CmdLists[cmdListIndex];
         populateVertexData(bufferIndex,
                 cmds->VtxBuffer.Size * sizeof(ImDrawVert), cmds->VtxBuffer.Data,
@@ -316,7 +316,7 @@ void ImGuiHelper::processImGuiCommands(ImDrawData* commands, const ImGuiIO& io)
         }
         bufferIndex++;
     }
-    if (commands->CmdListsCount > 0) {
+    if (commands->CmdLists.Size > 0) {
         rbuilder.build(*mEngine, mRenderable);
     }
 }
